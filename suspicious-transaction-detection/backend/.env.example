PORT=5000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# URL of the FastAPI ML service
ML_SERVICE_URL=http://localhost:8000
# Where transactions.csv / settings.json are persisted (use a persistent disk in production)
DATA_DIR=./data
# Path used by POST /api/transactions/load-sample
SAMPLE_DATASET=../ml-service/dataset/sample_transactions.csv
